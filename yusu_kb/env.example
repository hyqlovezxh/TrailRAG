# 语溯开源版环境配置
# 复制本文件为 .env 并填写密钥（.env 已被 .gitignore 保护，禁止提交/写入文档）

# 数据目录（知识库文件、向量库、SQLite 落盘位置）
YUSU_DATA_DIR=./yusu_data

# 聊天模型（OpenAI 兼容 /chat/completions）
YUSU_LLM_BASE_URL=https://token.sensenova.cn
YUSU_LLM_API_KEY=
YUSU_LLM_MODEL=sensenova-6.8-flash-lite

# Embedding 模型（OpenAI 兼容 /embeddings；未配置时回退使用 LLM 的 base_url/api_key）
YUSU_EMBED_BASE_URL=https://api.siliconflow.cn
YUSU_EMBED_API_KEY=
YUSU_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# 可选：维度未知时留空，首次使用时自动探测
YUSU_EMBED_DIM=
# 可选：单批最大条数（默认 40）
YUSU_EMBED_BATCH_SIZE=40

# Reranker（可选；留空 = 不使用重排序，仅向量/关键词分数）
YUSU_RERANK_MODEL=BAAI/bge-reranker-v2-m3
YUSU_RERANK_BASE_URL=https://api.siliconflow.cn
YUSU_RERANK_API_KEY=
# openai（默认）| dashscope
YUSU_RERANK_PROTOCOL=openai

# 可选：API 访问令牌（留空 = 不启用鉴权；前端/客户端请求须携带 Authorization: Bearer <token>）
YUSU_API_KEY=